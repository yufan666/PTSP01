index 0000000..97c9565
--- /dev/null
+++ b/sound/soc/ath79/ath79-audio.c
@@ -0,0 +1,909 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-3-Clause
+/*
+ * ath79-audio.c -- ASoC driver for the Atheros AR9331 I2S audio block
+ *
+ * Ported to the 6.12 ASoC API from:
+ *   - Qualcomm Atheros ath79-stereo BSP code (BSD)
+ *   - franzflasch/ar9331-i2s-alsa (BSD, Carambola2 machine)
+ *
+ * Structure:
+ *   - Stereo block  : 0x180B0000 (I2S controller + clock divider)
+ *   - DMA MBOX block: 0x180A0000 (descriptor ring FIFO DMA)
+ *   - Reset         : 0x18060020 (RST_RESET_MBOX bit)
+ *   - Pinmux        : handled via pinctrl-single (GPIO_FUNC bits 26/27/29)
+ *   - GPIO OE       : driven via the named "gpio" reg (0x18040000) RMW on
+ *                     bits 18..22, mirroring prepare_carambola2_i2s()
+ *
+ * DT node example:
+ *   audio_i2s: audio@180b0000 {
+ *       compatible = "qca,ar9331-i2s";
+ *       reg = <0x180b0000 0x1c>, <0x180a0000 0x6c>, <0x18060020 0x4>,
+ *             <0x18040000 0x28>;
+ *       reg-names = "stereo", "dma", "reset", "gpio";
+ *       interrupts = <7>;      // MISC INT bit 7 = DMA
+ *       status = "okay";
+ *   };
+ *
+ * Playback pin map (fixed by GPIO_FUNC I2S_GPIO_18_22_EN mux):
+ *   SCK=GPIO18 WS=GPIO19 SD=GPIO20 OMCLK=GPIO21 MIC=GPIO22(input)
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmapool.h>
+#include <linux/delay.h>
+#include <linux/spinlock.h>
+#include <linux/interrupt.h>
+#include <linux/slab.h>
+
+#include <sound/core.h>
+#include <sound/soc.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+
+/* ------------------------------------------------------------------ */
+/* register definitions (from ath79-stereo-regs.h / ar71xx_regs.h)    */
+/* ------------------------------------------------------------------ */
+
+#define AR934X_STEREO_REG_CONFIG			0x00
+#define AR934X_STEREO_CONFIG_SPDIF_ENABLE		BIT(23)
+#define AR934X_STEREO_CONFIG_I2S_ENABLE			BIT(21)
+#define AR934X_STEREO_CONFIG_MIC_RESET			BIT(20)
+#define AR934X_STEREO_CONFIG_RESET			BIT(19)
+#define AR934X_STEREO_CONFIG_I2S_DELAY			BIT(18)
+#define AR934X_STEREO_CONFIG_PCM_SWAP			BIT(17)
+#define AR934X_STEREO_CONFIG_MIC_WORD_SIZE		BIT(16)
+#define AR934X_STEREO_CONFIG_STEREO_MONO_SHIFT		14
+#define AR934X_STEREO_CONFIG_DATA_WORD_SIZE_SHIFT	12
+#define AR934X_STEREO_CONFIG_DATA_WORD_SIZE_MASK	0x03
+#define AR934X_STEREO_CONFIG_DATA_WORD_8		0
+#define AR934X_STEREO_CONFIG_DATA_WORD_16		1
+#define AR934X_STEREO_CONFIG_I2S_WORD_SIZE		BIT(11)
+#define AR934X_STEREO_CONFIG_MCK_SEL			BIT(10)
+#define AR934X_STEREO_CONFIG_SAMPLE_CNT_CLEAR_TYPE	BIT(9)
+#define AR934X_STEREO_CONFIG_MASTER			BIT(8)
+#define AR934X_STEREO_CONFIG_POSEDGE_MASK		0xff
+#define AR934X_STEREO_CONFIG_PSEDGE(x)			(AR934X_STEREO_CONFIG_POSEDGE_MASK & (x))
+
+#define AR934X_STEREO_CONFIG_CLK_DIV			0x1c
+
+/* DMA block (MBOX/PCM) */
+#define AR934X_DMA_REG_MBOX_DMA_POLICY			0x10
+#define AR934X_DMA_MBOX_DMA_POLICY_TX_FIFO_THRESH_SHIFT	4
+#define AR934X_DMA_MBOX_DMA_POLICY_TX_FIFO_THRESH_MASK	0xf
+#define AR934X_DMA_MBOX_DMA_POLICY_TX_QUANTUM		BIT(3)
+#define AR934X_DMA_MBOX_DMA_POLICY_RX_QUANTUM		BIT(1)
+#define AR934X_DMA_REG_MBOX0_DMA_RX_DESCRIPTOR_BASE	0x18
+#define AR934X_DMA_REG_MBOX0_DMA_RX_CONTROL		0x1c
+#define AR934X_DMA_REG_MBOX0_DMA_TX_DESCRIPTOR_BASE	0x20
+#define AR934X_DMA_REG_MBOX0_DMA_TX_CONTROL		0x24
+#define AR934X_DMA_MBOX_DMA_CONTROL_RESUME		BIT(2)
+#define AR934X_DMA_MBOX_DMA_CONTROL_START		BIT(1)
+#define AR934X_DMA_MBOX_DMA_CONTROL_STOP		BIT(0)
+#define AR934X_DMA_REG_MBOX_INT_STATUS			0x44
+#define AR934X_DMA_MBOX_INT_STATUS_RX_DMA_COMPLETE	BIT(10)
+#define AR934X_DMA_MBOX_INT_STATUS_TX_DMA_COMPLETE	BIT(6)
+#define AR934X_DMA_REG_MBOX_INT_ENABLE			0x4c
+#define AR934X_DMA_MBOX0_INT_RX_COMPLETE		BIT(10)
+#define AR934X_DMA_MBOX0_INT_TX_COMPLETE		BIT(6)
+#define AR934X_DMA_REG_MBOX_FIFO_RESET			0x58
+#define AR934X_DMA_MBOX0_FIFO_RESET_RX			BIT(2)
+#define AR934X_DMA_MBOX0_FIFO_RESET_TX			BIT(0)
+
+/* reset block */
+#define AR934X_RESET_REG_RESET_MODULE			0x00	/* phys 0x18060020 */
+/*
+ * AR9331 复位位：MBOX DMA 复用 AR71XX_RESET_DMA (BIT19)，
+ * stereo 块为 AR71XX_RESET_STEREO (BIT17) —— 见 mainline ar71xx_regs.h
+ * （AR9331 没有独立 AR934X_RESET_MBOX 位）。
+ */
+#define AR933X_RESET_MBOX_DMA				BIT(19)
+#define AR933X_RESET_STEREO				BIT(17)
+
+/* gpio block (phys 0x18040000) */
+#define AR71XX_GPIO_REG_OE				0x00
+#define AR71XX_GPIO_REG_FUNCTIONS			0x28
+
+/* I2S GPIO function bits in GPIO_FUNCTIONS (0x18040028) */
+#define AR7240_GPIO_FUNCTION_I2S_GPIO_18_22_EN		BIT(29)
+#define AR7240_GPIO_FUNCTION_I2S_REFCLKEN		BIT(28)
+#define AR7240_GPIO_FUNCTION_I2S_MCKEN			BIT(27)
+#define AR7240_GPIO_FUNCTION_I2S0_EN			BIT(26)
+
+/* ------------------------------------------------------------------ */
+/* descriptor / private data                                          */
+/* ------------------------------------------------------------------ */
+
+struct ath79_pcm_desc {
+	unsigned int	OWN	:  1,	/* bit 31 */
+			EOM	:  1,	/* bit 30 */
+			rsvd1	:  6,	/* bit 29-24 */
+			size	: 12,	/* bit 23-12 */
+			length	: 12,	/* bit 11-00 */
+			rsvd2	:  4,	/* bit 31-28 */
+			BufPtr	: 28,	/* bit 27-00 */
+			rsvd3	:  4,	/* bit 31-28 */
+			NextPtr	: 28;	/* bit 27-00 */
+
+	/* hardware descriptor ends here; software fields below live in
+	 * the same allocation but are never seen by the DMA engine as
+	 * long as desc size (32 bytes) is what the pool provides */
+	unsigned int Va[6];
+	unsigned int Ua[6];
+	unsigned int Ca[6];
+	unsigned int Vb[6];
+	unsigned int Ub[6];
+	unsigned int Cb[6];
+
+	struct list_head list;
+	dma_addr_t phys;
+};
+
+struct ath79_pcm_rt_priv {
+	struct list_head dma_head;
+	struct ath79_pcm_desc *last_played;
+	unsigned int elapsed_size;
+	unsigned int delay_time;
+	int direction;
+};
+
+struct ath79_audio_priv {
+	void __iomem *stereo;
+	void __iomem *dma;
+	void __iomem *reset;
+	void __iomem *gpio;
+	struct dma_pool *desc_pool;
+	struct snd_pcm_substream *playback;
+	struct snd_pcm_substream *capture;
+	spinlock_t lock;
+};
+
+static DEFINE_SPINLOCK(ath79_mbox_lock);
+static struct dma_pool *ath79_desc_pool;	/* single instance driver */
+static struct ath79_audio_priv *ath79_drvdata;
+
+/* ------------------------------------------------------------------ */
+/* register access helpers                                            */
+/* ------------------------------------------------------------------ */
+
+static inline void stereo_wr(u32 reg, u32 val)
+{
+	__raw_writel(val, ath79_drvdata->stereo + reg);
+}
+
+static inline u32 stereo_rr(u32 reg)
+{
+	return __raw_readl(ath79_drvdata->stereo + reg);
+}
+
+static inline void dma_wr(u32 reg, u32 val)
+{
+	__raw_writel(val, ath79_drvdata->dma + reg);
+}
+
+static inline u32 dma_rr(u32 reg)
+{
+	return __raw_readl(ath79_drvdata->dma + reg);
+}
+
+static inline void mbox_reset(void)
+{
+	u32 t;
+
+	spin_lock(&ath79_mbox_lock);
+
+	t = __raw_readl(ath79_drvdata->reset + AR934X_RESET_REG_RESET_MODULE);
+	t |= AR933X_RESET_MBOX_DMA;
+	__raw_writel(t, ath79_drvdata->reset + AR934X_RESET_REG_RESET_MODULE);
+	__raw_readl(ath79_drvdata->reset + AR934X_RESET_REG_RESET_MODULE);
+	udelay(50);
+	t &= ~AR933X_RESET_MBOX_DMA;
+	__raw_writel(t, ath79_drvdata->reset + AR934X_RESET_REG_RESET_MODULE);
+	__raw_readl(ath79_drvdata->reset + AR934X_RESET_REG_RESET_MODULE);
+
+	spin_unlock(&ath79_mbox_lock);
+}
+
+static void ath79_stereo_reset(void)
+{
+	u32 t;
+
+	spin_lock(&ath79_mbox_lock);
+	t = stereo_rr(AR934X_STEREO_REG_CONFIG);
+	t |= AR934X_STEREO_CONFIG_RESET;
+	stereo_wr(AR934X_STEREO_REG_CONFIG, t);
+	spin_unlock(&ath79_mbox_lock);
+}
+
+static void mbox_fifo_reset(u32 mask)
+{
+	dma_wr(AR934X_DMA_REG_MBOX_FIFO_RESET, mask);
+	udelay(50);
+	/* Datasheet says reset the stereo controller whenever the MBOX
+	 * DMA controller is reset */
+	ath79_stereo_reset();
+}
+
+static void mbox_dma_reset(void)
+{
+	mbox_reset();
+	mbox_fifo_reset(AR934X_DMA_MBOX0_FIFO_RESET_RX |
+			AR934X_DMA_MBOX0_FIFO_RESET_TX);
+}
+
+static void mbox_interrupt_enable(u32 mask)
+{
+	u32 t;
+
+	spin_lock(&ath79_mbox_lock);
+	t = dma_rr(AR934X_DMA_REG_MBOX_INT_ENABLE);
+	t |= mask;
+	dma_wr(AR934X_DMA_REG_MBOX_INT_ENABLE, t);
+	spin_unlock(&ath79_mbox_lock);
+}
+
+static void mbox_interrupt_ack(u32 mask)
+{
+	dma_wr(AR934X_DMA_REG_MBOX_INT_STATUS, mask);
+	/* flush */
+	dma_rr(AR934X_DMA_REG_MBOX_INT_STATUS);
+}
+
+/* ------------------------------------------------------------------ */
+/* descriptor ring management                                         */
+/* ------------------------------------------------------------------ */
+
+static unsigned int ath79_pcm_set_own_bits(struct ath79_pcm_rt_priv *rtpriv)
+{
+	struct ath79_pcm_desc *desc;
+	unsigned int size_played = 0;
+
+	spin_lock(&ath79_mbox_lock);
+	list_for_each_entry(desc, &rtpriv->dma_head, list) {
+		if (desc->OWN == 0) {
+			desc->OWN = 1;
+			size_played += desc->size;
+		}
+	}
+	spin_unlock(&ath79_mbox_lock);
+	return size_played;
+}
+
+static struct ath79_pcm_desc *ath79_pcm_get_last_played(struct ath79_pcm_rt_priv *rtpriv)
+{
+	struct ath79_pcm_desc *desc, *prev;
+
+	spin_lock(&ath79_mbox_lock);
+	prev = list_entry(rtpriv->dma_head.prev, struct ath79_pcm_desc, list);
+	list_for_each_entry(desc, &rtpriv->dma_head, list) {
+		if (desc->OWN == 1 && prev->OWN == 0) {
+			spin_unlock(&ath79_mbox_lock);
+			return desc;
+		}
+		prev = desc;
+	}
+	spin_unlock(&ath79_mbox_lock);
+	return NULL;
+}
+
+static void mbox_dma_start(struct ath79_pcm_rt_priv *rtpriv)
+{
+	if (rtpriv->direction == SNDRV_PCM_STREAM_PLAYBACK) {
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_RX_CONTROL,
+		       AR934X_DMA_MBOX_DMA_CONTROL_START);
+		dma_rr(AR934X_DMA_REG_MBOX0_DMA_RX_CONTROL);
+	} else {
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_TX_CONTROL,
+		       AR934X_DMA_MBOX_DMA_CONTROL_START);
+		dma_rr(AR934X_DMA_REG_MBOX0_DMA_TX_CONTROL);
+	}
+}
+
+static void mbox_dma_stop(struct ath79_pcm_rt_priv *rtpriv)
+{
+	if (rtpriv->direction == SNDRV_PCM_STREAM_PLAYBACK) {
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_RX_CONTROL,
+		       AR934X_DMA_MBOX_DMA_CONTROL_STOP);
+		dma_rr(AR934X_DMA_REG_MBOX0_DMA_RX_CONTROL);
+	} else {
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_TX_CONTROL,
+		       AR934X_DMA_MBOX_DMA_CONTROL_STOP);
+		dma_rr(AR934X_DMA_REG_MBOX0_DMA_TX_CONTROL);
+	}
+
+	/* Wait so the DMA engine is truly idle before the buffer memory
+	 * is freed / unmapped (max one descriptor + margin). */
+	mdelay(rtpriv->delay_time);
+}
+
+static int mbox_dma_map(struct ath79_pcm_rt_priv *rtpriv, dma_addr_t baseaddr,
+			int period_bytes, int bufsize)
+{
+	struct list_head *head = &rtpriv->dma_head;
+	struct ath79_pcm_desc *desc, *prev;
+	dma_addr_t desc_p;
+	unsigned int offset = 0;
+
+	spin_lock(&ath79_mbox_lock);
+
+	rtpriv->elapsed_size = 0;
+	do {
+		/* called with ath79_mbox_lock held -> must not sleep */
+		desc = dma_pool_alloc(ath79_desc_pool, GFP_ATOMIC, &desc_p);
+		if (!desc) {
+			spin_unlock(&ath79_mbox_lock);
+			return -ENOMEM;
+		}
+		memset(desc, 0, sizeof(struct ath79_pcm_desc));
+		desc->phys = desc_p;
+		list_add_tail(&desc->list, head);
+
+		desc->OWN = 1;
+		desc->EOM = 0;
+
+		/* buffer size may not be a multiple of period_bytes */
+		if (bufsize >= offset + period_bytes)
+			desc->size = period_bytes;
+		else
+			desc->size = bufsize - offset;
+		desc->BufPtr = (u32)baseaddr + offset;
+
+		/* for now assume the buffer is always full */
+		desc->length = desc->size;
+
+		if (desc->list.prev != head) {
+			prev = list_entry(desc->list.prev,
+					  struct ath79_pcm_desc, list);
+			prev->NextPtr = (u32)desc->phys;
+		}
+
+		offset += desc->size;
+	} while (offset < bufsize);
+
+	/* close the ring */
+	desc = list_first_entry(head, struct ath79_pcm_desc, list);
+	prev = list_entry(head->prev, struct ath79_pcm_desc, list);
+	prev->NextPtr = (u32)desc->phys;
+
+	spin_unlock(&ath79_mbox_lock);
+	return 0;
+}
+
+static void mbox_dma_unmap(struct ath79_pcm_rt_priv *rtpriv)
+{
+	struct list_head *head = &rtpriv->dma_head;
+	struct ath79_pcm_desc *desc, *n;
+
+	spin_lock(&ath79_mbox_lock);
+	list_for_each_entry_safe(desc, n, head, list) {
+		list_del(&desc->list);
+		dma_pool_free(ath79_desc_pool, desc, desc->phys);
+	}
+	spin_unlock(&ath79_mbox_lock);
+}
+
+static void mbox_dma_prepare(struct ath79_pcm_rt_priv *rtpriv)
+{
+	struct ath79_pcm_desc *desc;
+	u32 t;
+
+	if (rtpriv->direction == SNDRV_PCM_STREAM_PLAYBACK) {
+		t = dma_rr(AR934X_DMA_REG_MBOX_DMA_POLICY);
+		dma_wr(AR934X_DMA_REG_MBOX_DMA_POLICY,
+		       t | AR934X_DMA_MBOX_DMA_POLICY_RX_QUANTUM |
+		       (6 << AR934X_DMA_MBOX_DMA_POLICY_TX_FIFO_THRESH_SHIFT));
+
+		/* DMA-engine perspective: playback uses the RX regs */
+		desc = list_first_entry(&rtpriv->dma_head,
+					struct ath79_pcm_desc, list);
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_RX_DESCRIPTOR_BASE,
+		       (u32)desc->phys);
+		mbox_interrupt_enable(AR934X_DMA_MBOX0_INT_RX_COMPLETE);
+	} else {
+		t = dma_rr(AR934X_DMA_REG_MBOX_DMA_POLICY);
+		dma_wr(AR934X_DMA_REG_MBOX_DMA_POLICY,
+		       t | AR934X_DMA_MBOX_DMA_POLICY_TX_QUANTUM |
+		       (6 << AR934X_DMA_MBOX_DMA_POLICY_TX_FIFO_THRESH_SHIFT));
+
+		desc = list_first_entry(&rtpriv->dma_head,
+					struct ath79_pcm_desc, list);
+		dma_wr(AR934X_DMA_REG_MBOX0_DMA_TX_DESCRIPTOR_BASE,
+		       (u32)desc->phys);
+		mbox_interrupt_enable(AR934X_DMA_MBOX0_INT_TX_COMPLETE);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* IRQ                                                                */
+/* ------------------------------------------------------------------ */
+
+static irqreturn_t ath79_pcm_interrupt(int irq, void *dev_id)
+{
+	struct ath79_audio_priv *priv = dev_id;
+	struct ath79_pcm_rt_priv *rtpriv;
+	u32 status;
+
+	status = dma_rr(AR934X_DMA_REG_MBOX_INT_STATUS);
+
+	if (status & AR934X_DMA_MBOX_INT_STATUS_RX_DMA_COMPLETE) {
+		unsigned int played_size, period_bytes;
+
+		rtpriv = priv->playback ?
+			priv->playback->runtime->private_data : NULL;
+		if (rtpriv) {
+			rtpriv->last_played = ath79_pcm_get_last_played(rtpriv);
+			period_bytes =
+				snd_pcm_lib_period_bytes(priv->playback);
+			played_size = ath79_pcm_set_own_bits(rtpriv);
+			if (played_size > period_bytes)
+				pr_debug("ath79-audio: played more than one period: %d\n",
+					 played_size);
+			rtpriv->elapsed_size += played_size;
+			mbox_interrupt_ack(
+				AR934X_DMA_MBOX_INT_STATUS_RX_DMA_COMPLETE);
+			if (rtpriv->elapsed_size >= period_bytes) {
+				rtpriv->elapsed_size %= period_bytes;
+				snd_pcm_period_elapsed(priv->playback);
+			}
+			if (!rtpriv->last_played)
+				pr_debug("ath79-audio: ISR called but no played buf\n");
+		} else {
+			mbox_interrupt_ack(
+				AR934X_DMA_MBOX_INT_STATUS_RX_DMA_COMPLETE);
+		}
+	}
+
+	if (status & AR934X_DMA_MBOX_INT_STATUS_TX_DMA_COMPLETE) {
+		rtpriv = priv->capture ?
+			priv->capture->runtime->private_data : NULL;
+		mbox_interrupt_ack(
+			AR934X_DMA_MBOX_INT_STATUS_TX_DMA_COMPLETE);
+		if (rtpriv) {
+			rtpriv->last_played = ath79_pcm_get_last_played(rtpriv);
+			ath79_pcm_set_own_bits(rtpriv);
+			snd_pcm_period_elapsed(priv->capture);
+		}
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/* PCM (component callbacks)                                          */
+/* ------------------------------------------------------------------ */
+
+#define BUFFER_BYTES_MAX	(1024 * 1024)
+#define PERIOD_BYTES_MIN	64
+
+static const struct snd_pcm_hardware ath79_pcm_hardware = {
+	.info = SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_MMAP_VALID |
+		SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_NO_PERIOD_WAKEUP,
+	.formats = SNDRV_PCM_FMTBIT_S8 |
+		   SNDRV_PCM_FMTBIT_S16_BE |
+		   SNDRV_PCM_FMTBIT_S16_LE,
+	.rates = SNDRV_PCM_RATE_44100 |
+		 SNDRV_PCM_RATE_48000,
+	.rate_min = 44100,
+	.rate_max = 48000,
+	.channels_min = 2,
+	.channels_max = 2,
+	.buffer_bytes_max = BUFFER_BYTES_MAX,
+	.period_bytes_min = PERIOD_BYTES_MIN,
+	.period_bytes_max = 4095,
+	.periods_min = 16,
+	.periods_max = 256,
+	.fifo_size = 0,
+};
+
+static int ath79_pcm_open(struct snd_soc_component *component,
+			  struct snd_pcm_substream *ss)
+{
+	struct ath79_audio_priv *priv = snd_soc_component_get_drvdata(component);
+	struct ath79_pcm_rt_priv *rtpriv;
+
+	rtpriv = kzalloc(sizeof(*rtpriv), GFP_KERNEL);
+	if (!rtpriv)
+		return -ENOMEM;
+
+	ss->runtime->private_data = rtpriv;
+	rtpriv->last_played = NULL;
+	INIT_LIST_HEAD(&rtpriv->dma_head);
+	rtpriv->direction = ss->stream;
+
+	if (ss->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		priv->playback = ss;
+	else
+		priv->capture = ss;
+
+	snd_soc_set_runtime_hwparams(ss, &ath79_pcm_hardware);
+	return 0;
+}
+
+static int ath79_pcm_close(struct snd_soc_component *component,
+			   struct snd_pcm_substream *ss)
+{
+	struct ath79_audio_priv *priv = snd_soc_component_get_drvdata(component);
+	struct ath79_pcm_rt_priv *rtpriv = ss->runtime->private_data;
+
+	if (ss->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		priv->playback = NULL;
+	else
+		priv->capture = NULL;
+
+	kfree(rtpriv);
+	return 0;
+}
+
+static int ath79_pcm_hw_params(struct snd_soc_component *component,
+			       struct snd_pcm_substream *ss,
+			       struct snd_pcm_hw_params *hw_params)
+{
+	struct snd_pcm_runtime *runtime = ss->runtime;
+	struct ath79_pcm_rt_priv *rtpriv = runtime->private_data;
+	unsigned int period_size, sample_size, sample_rate, frames, channels;
+	int ret;
+
+	ret = mbox_dma_map(rtpriv, runtime->dma_addr,
+			   params_period_bytes(hw_params),
+			   params_buffer_bytes(hw_params));
+	if (ret < 0)
+		return ret;
+
+	period_size = params_period_bytes(hw_params);
+	sample_size = snd_pcm_format_size(params_format(hw_params), 1);
+	sample_rate = params_rate(hw_params);
+	channels = params_channels(hw_params);
+	frames = period_size / (sample_size * channels);
+
+	/* longest time the DMA engine could be grabbing bytes, +10ms
+	 * margin, used in mbox_dma_stop() */
+	rtpriv->delay_time = (frames * 1000) / sample_rate + 10;
+
+	return 0;
+}
+
+static int ath79_pcm_hw_free(struct snd_soc_component *component,
+			     struct snd_pcm_substream *ss)
+{
+	struct ath79_pcm_rt_priv *rtpriv = ss->runtime->private_data;
+
+	mbox_dma_unmap(rtpriv);
+	return 0;
+}
+
+static int ath79_pcm_prepare(struct snd_soc_component *component,
+			     struct snd_pcm_substream *ss)
+{
+	struct ath79_pcm_rt_priv *rtpriv = ss->runtime->private_data;
+	struct snd_soc_pcm_runtime *rtd = ss->private_data;
+	struct snd_soc_dai *cpu_dai;
+
+	cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	/* first active stream resets the DMA MBOX controller */
+	if (snd_soc_dai_active(cpu_dai) == 1)
+		mbox_dma_reset();
+
+	mbox_dma_prepare(rtpriv);
+	ath79_pcm_set_own_bits(rtpriv);
+	rtpriv->last_played = NULL;
+
+	return 0;
+}
+
+static int ath79_pcm_trigger(struct snd_soc_component *component,
+			     struct snd_pcm_substream *ss, int cmd)
+{
+	struct ath79_pcm_rt_priv *rtpriv = ss->runtime->private_data;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		mbox_dma_start(rtpriv);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+		mbox_dma_stop(rtpriv);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static snd_pcm_uframes_t ath79_pcm_pointer(struct snd_soc_component *component,
+					   struct snd_pcm_substream *ss)
+{
+	struct snd_pcm_runtime *runtime = ss->runtime;
+	struct ath79_pcm_rt_priv *rtpriv = runtime->private_data;
+	unsigned int bytes = 0;
+
+	if (rtpriv->last_played)
+		bytes = rtpriv->last_played->BufPtr - (u32)runtime->dma_addr;
+
+	return bytes_to_frames(runtime, bytes);
+}
+
+/* ------------------------------------------------------------------ */
+/* I2S DAI                                                            */
+/* ------------------------------------------------------------------ */
+
+struct ath79_snd_clk_config {
+	unsigned int freq;
+	unsigned int divint;
+	unsigned int divfrac;
+	unsigned int posedge;
+};
+
+/*
+ * AR9331 stereo block reference clock = 200 MHz (PLL).
+ * MCLK = 200MHz * 2^16 / ((divint << 16) + divfrac):
+ *   44100: 11.2907 MHz (~256 fs, 0.01% off)
+ *   48000: 12.2883 MHz (~256 fs)
+ * Table inherited verbatim from the Qualcomm BSP / franzflasch code.
+ */
+static const struct ath79_snd_clk_config clk_cfg[] = {
+	/* freq,  divint, divfrac, posedge */
+	{ 44100, 0x11,   0xB726,  0x2 },
+	{ 48000, 0x10,   0x46AB,  0x2 },
+};
+
+static int ath79_i2s_startup(struct snd_pcm_substream *substream,
+			     struct snd_soc_dai *dai)
+{
+	/* 6.12: struct snd_soc_dai has no ->active member anymore */
+	if (!snd_soc_dai_active(dai)) {
+		stereo_wr(AR934X_STEREO_REG_CONFIG,
+			  AR934X_STEREO_CONFIG_SPDIF_ENABLE |
+			  AR934X_STEREO_CONFIG_I2S_ENABLE |
+			  AR934X_STEREO_CONFIG_SAMPLE_CNT_CLEAR_TYPE |
+			  AR934X_STEREO_CONFIG_MASTER);
+		ath79_stereo_reset();
+	}
+	return 0;
+}
+
+static void ath79_i2s_shutdown(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	/* last stream going down: the current one is still counted here */
+	if (snd_soc_dai_active(dai) <= 1)
+		stereo_wr(AR934X_STEREO_REG_CONFIG, 0);
+}
+
+static int ath79_i2s_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	u32 mask = 0, t;
+	int clk_cfg_idx;
+	int n = ARRAY_SIZE(clk_cfg);
+
+	for (clk_cfg_idx = 0; clk_cfg_idx < n; clk_cfg_idx++) {
+		if (params_rate(params) == clk_cfg[clk_cfg_idx].freq)
+			break;
+	}
+
+	if (clk_cfg_idx == n) {
+		dev_err(dai->dev, "No valid clock config for %d Hz\n",
+			params_rate(params));
+		return -EINVAL;
+	}
+
+	stereo_wr(AR934X_STEREO_CONFIG_CLK_DIV,
+		  (clk_cfg[clk_cfg_idx].divint << 16) +
+		  clk_cfg[clk_cfg_idx].divfrac);
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S8:
+		mask |= AR934X_STEREO_CONFIG_DATA_WORD_8 <<
+			AR934X_STEREO_CONFIG_DATA_WORD_SIZE_SHIFT;
+		break;
+	case SNDRV_PCM_FORMAT_S16_LE:
+		mask |= AR934X_STEREO_CONFIG_PCM_SWAP;
+		fallthrough;
+	case SNDRV_PCM_FORMAT_S16_BE:
+		mask |= AR934X_STEREO_CONFIG_DATA_WORD_16 <<
+			AR934X_STEREO_CONFIG_DATA_WORD_SIZE_SHIFT;
+		break;
+	default:
+		dev_err(dai->dev, "Format %d not supported\n",
+			params_format(params));
+		return -EINVAL;
+	}
+
+	spin_lock(&ath79_mbox_lock);
+	t = stereo_rr(AR934X_STEREO_REG_CONFIG);
+	t &= ~(AR934X_STEREO_CONFIG_DATA_WORD_SIZE_MASK <<
+	       AR934X_STEREO_CONFIG_DATA_WORD_SIZE_SHIFT);
+	t &= ~AR934X_STEREO_CONFIG_I2S_WORD_SIZE;
+	t |= mask;
+	t |= AR934X_STEREO_CONFIG_PSEDGE(clk_cfg[clk_cfg_idx].posedge);
+	stereo_wr(AR934X_STEREO_REG_CONFIG, t);
+	spin_unlock(&ath79_mbox_lock);
+
+	ath79_stereo_reset();
+	return 0;
+}
+
+static int ath79_i2s_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+				unsigned int rate, int dir)
+{
+	/*
+	 * simple-audio-card feeds us rate * mclk_fs here; the actual
+	 * MCLK divider is programmed from hw_params.  Accept and ignore.
+	 */
+	return 0;
+}
+
+static const struct snd_soc_dai_ops ath79_i2s_dai_ops = {
+	.startup	= ath79_i2s_startup,
+	.shutdown	= ath79_i2s_shutdown,
+	.hw_params	= ath79_i2s_hw_params,
+	.set_sysclk	= ath79_i2s_set_sysclk,
+};
+
+static struct snd_soc_dai_driver ath79_i2s_dai = {
+	.name = "ath79-i2s",
+	.playback = {
+		.channels_min = 2,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S8 |
+			   SNDRV_PCM_FMTBIT_S16_BE |
+			   SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &ath79_i2s_dai_ops,
+};
+
+static int ath79_soc_pcm_construct(struct snd_soc_component *component,
+				   struct snd_soc_pcm_runtime *rtd);
+
+static const struct snd_soc_component_driver ath79_component = {
+	.name			= "ath79-i2s",
+	.open			= ath79_pcm_open,
+	.close			= ath79_pcm_close,
+	.hw_params		= ath79_pcm_hw_params,
+	.hw_free		= ath79_pcm_hw_free,
+	.prepare		= ath79_pcm_prepare,
+	.trigger		= ath79_pcm_trigger,
+	.pointer		= ath79_pcm_pointer,
+	.pcm_construct		= ath79_soc_pcm_construct,
+	.legacy_dai_naming	= 1,
+};
+
+static int ath79_soc_pcm_construct(struct snd_soc_component *component,
+				   struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_pcm *pcm = rtd->pcm;
+
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_DEV,
+				       rtd->card->dev,
+				       BUFFER_BYTES_MAX, BUFFER_BYTES_MAX);
+	return 0;
+}
