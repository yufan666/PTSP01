+/* ------------------------------------------------------------------ */
+/* probe / remove                                                     */
+/* ------------------------------------------------------------------ */
+
+static int ath79_audio_probe(struct platform_device *pdev)
+{
+	struct ath79_audio_priv *priv;
+	int irq, ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->stereo = devm_platform_ioremap_resource_byname(pdev, "stereo");
+	if (IS_ERR(priv->stereo))
+		return PTR_ERR(priv->stereo);
+
+	priv->dma = devm_platform_ioremap_resource_byname(pdev, "dma");
+	if (IS_ERR(priv->dma))
+		return PTR_ERR(priv->dma);
+
+	priv->reset = devm_platform_ioremap_resource_byname(pdev, "reset");
+	if (IS_ERR(priv->reset))
+		return PTR_ERR(priv->reset);
+
+	priv->gpio = devm_platform_ioremap_resource_byname(pdev, "gpio");
+	if (IS_ERR(priv->gpio)) {
+		/*
+		 * The GPIO block 0x18040000 is already claimed by the
+		 * ath79 gpio controller driver.  Remap without claiming
+		 * the region again (we only RMW the OE register bits).
+		 */
+		struct resource *res = platform_get_resource_byname(pdev,
+							IORESOURCE_MEM, "gpio");
+		if (!res)
+			return -ENODEV;
+		priv->gpio = devm_ioremap(&pdev->dev, res->start,
+					  resource_size(res));
+		if (!priv->gpio)
+			return -ENOMEM;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	spin_lock_init(&priv->lock);
+
+	dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+
+	ath79_drvdata = priv;
+	platform_set_drvdata(pdev, priv);
+
+	/* GPIO output-enable for the I2S pins, mirroring
+	 * prepare_carambola2_i2s(): pins 18..21 output, 22 (MIC) input.
+	 * Function mux bits 26/27/29 are set from DT via pinctrl-single. */
+	{
+		void __iomem *oe = priv->gpio + AR71XX_GPIO_REG_OE;
+		u32 t = __raw_readl(oe);
+
+		t |= (1 << 18) | (1 << 19) | (1 << 20) | (1 << 21);
+		t &= ~(1 << 22);
+		__raw_writel(t, oe);
+		__raw_readl(oe);
+	}
+
+	ath79_desc_pool = dma_pool_create("ath79-audio-desc", &pdev->dev,
+					  sizeof(struct ath79_pcm_desc),
+					  4, 0);
+	if (!ath79_desc_pool)
+		return -ENOMEM;
+
+	ret = devm_request_irq(&pdev->dev, irq, ath79_pcm_interrupt, 0,
+			       dev_name(&pdev->dev), priv);
+	if (ret)
+		goto err_pool;
+
+	mbox_dma_reset();
+
+	ret = devm_snd_soc_register_component(&pdev->dev, &ath79_component,
+					      &ath79_i2s_dai, 1);
+	if (ret)
+		goto err_pool;
+
+	return 0;
+
+err_pool:
+	dma_pool_destroy(ath79_desc_pool);
+	ath79_desc_pool = NULL;
+	ath79_drvdata = NULL;
+	return ret;
+}
+
+static void ath79_audio_remove(struct platform_device *pdev)
+{
+	dma_pool_destroy(ath79_desc_pool);
+	ath79_desc_pool = NULL;
+	ath79_drvdata = NULL;
+}
+
+static const struct of_device_id ath79_audio_of_match[] = {
+	{ .compatible = "qca,ar9331-i2s" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ath79_audio_of_match);
+
+static struct platform_driver ath79_audio_driver = {
+	.probe = ath79_audio_probe,
+	.remove = ath79_audio_remove,
+	.driver = {
+		.name = "ath79-audio",
+		.of_match_table = ath79_audio_of_match,
+	},
+};
+module_platform_driver(ath79_audio_driver);
