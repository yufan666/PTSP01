#!/bin/sh /etc/rc.common
# ptsp01-usbwan —— USB 上行守护（随身 WiFi / USB 网卡）
# 依赖 buildroot.config 里的 kmod-usb-chipidea(+2) 与 kmod-usb-net-*
# 没插设备时守护只在后台空转（6 秒一次 sysfs 扫描，几乎无开销）

START=95
USE_PROCD=1

start_service() {
	if [ ! -d /sys/bus/usb/devices ]; then
		echo "内核未加载 USB 主机驱动（kmod-usb-chipidea），跳过 USB 上行守护"
		return 1
	fi
	procd_open_instance
	procd_set_param command /bin/sh /usr/bin/ptsp01-usbwan.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
