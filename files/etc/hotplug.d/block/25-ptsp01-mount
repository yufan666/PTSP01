#!/bin/sh
# 25-ptsp01-mount —— U 盘 / 移动硬盘热插拔自动挂载
#
# 挂载点固定 /mnt/usb1 … /mnt/usb8（空位优先，稳定可预期，方便脚本引用）
# 已被 block-mount（/etc/config/fstab）挂载的设备不重复挂，避免两个挂载点同一分区
#
# 支持文件系统：vfat(FAT32) / exfat / ext4 —— 对应 kmod-fs-{vfat,exfat,ext4}
# 注意：NTFS 未编入（如需请加 kmod-fs-ntfs3）

[ "$ACTION" = "add" ] || exit 0
[ -n "$DEVNAME" ] || exit 0

DEV="/dev/$DEVNAME"
[ -b "$DEV" ] || exit 0

is_mounted() { awk -v m="$1" '$2==m{found=1} END{exit !found}' /proc/mounts; }
dev_mounted() { awk -v d="$1" '$1==d{found=1} END{exit !found}' /proc/mounts; }

logger -t ptsp01-usb "block add $DEV"

# block-mount / fstab 已处理过 → 只记录
if dev_mounted "$DEV"; then
	logger -t ptsp01-usb "$DEV 已由 fstab/block-mount 挂载，跳过"
	exit 0
fi

i=1
while [ "$i" -le 8 ]; do
	MP="/mnt/usb$i"
	if ! is_mounted "$MP"; then
		mkdir -p "$MP"
		for FS in vfat exfat ext4; do
			if mount -t "$FS" -o rw,noatime,utf8 "$DEV" "$MP" 2>/dev/null; then
				logger -t ptsp01-usb "已挂载 $DEV -> $MP ($FS)"
				exit 0
			fi
		done
		rmdir "$MP" 2>/dev/null
		logger -t ptsp01-usb "$DEV 文件系统不支持（试过 vfat/exfat/ext4）"
		exit 0
	fi
	i=$((i + 1))
done

logger -t ptsp01-usb "挂载点 /mnt/usb1-8 全占满，$DEV 未挂载"
exit 0
