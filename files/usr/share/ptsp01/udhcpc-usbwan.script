#!/bin/sh
# udhcpc-usbwan.script —— 仅供 ptsp01-usbwan.sh 使用的 udhcpc 回调
#
# 为什么不用 /usr/share/udhcpc/default.script：
#   它会 `route add default gw $router`（metric 0），会把主 WAN 的默认路由顶掉，
#   导致插排自己的管理地址失联。这里只配地址 + 按配置加一个高 metric 的备份路由。

METRIC=$(uci -q get ptsp01.main.usbwan_metric)
METRIC=${METRIC:-300}

case "$1" in
	deconfig)
		ifconfig "$IFACE" 0.0.0.0 2>/dev/null
		;;
	bound|renew)
		[ -n "$ip" ] || exit 0
		ifconfig "$IFACE" "$ip" netmask "${subnet:-255.255.255.0}" up 2>/dev/null
		if [ "$METRIC" != "0" ] && [ -n "$router" ]; then
			# 先清掉 udhcpc 可能已加的 metric 0 路由，再按我们的 metric 重加
			route del default gw "$router" dev "$IFACE" 2>/dev/null
			route add default gw "$router" dev "$IFACE" metric "$METRIC" 2>/dev/null
		fi
		;;
esac

exit 0
