#!/bin/sh
# switch —— GET /cgi-bin/switch?id=1|2|3|all&state=0|1|toggle
# 控制继电器。编排逻辑统一在 pl7223.sh 的 do_switch（完整唤醒协议）。

printf 'Content-Type: application/json\r\n\r\n'

. /usr/lib/ptsp01/pl7223.sh

qs_get() { echo "$QUERY_STRING" | tr '&' '\n' | grep "^$1=" | cut -d= -f2- | head -1; }

ID=$(qs_get id)
ST=$(qs_get state)

case "$ID" in 1|2|3|all) ;; *) echo '{"ok":false,"err":"bad id"}'; exit 0;; esac
case "$ST" in 0|1|toggle) ;; *) echo '{"ok":false,"err":"bad state"}'; exit 0;; esac

if [ "$ST" = "toggle" ]; then
  ensure_state
  read s1 s2 s3 < $STATE
  case "$ID" in
    1) ST=$(( 1 - s1 ));;
    2) ST=$(( 1 - s2 ));;
    3) ST=$(( 1 - s3 ));;
    all) ST=$(( 1 - s1 ));;
  esac
fi

R=$(do_switch "$ID" "$ST") || { echo '{"ok":false,"err":"busy"}'; exit 0; }
# R = "f1 f2 f3"；孔1 本版不参与 SPI，回读可能是 "-"，必须转成 null 才是合法 JSON
f1=${R%% *}; rest=${R#* }; f2=${rest%% *}; f3=${rest#* }
jv() { case "$1" in 0|1) echo "$1";; *) echo "null";; esac; }
J1=$(jv "$f1"); J2=$(jv "$f2"); J3=$(jv "$f3")

echo '{"ok":true,"readback":['"$J1,$J2,$J3"'],"states":{"1":'"$J1"',"2":'"$J2"',"3":'"$J3"'}}'
