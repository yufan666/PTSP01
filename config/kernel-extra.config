# PTSP01 —— 追加到 target/linux/ath79/config-6.12 的内核选项
#
# 为什么要 /dev/mem：
#   PL7223 原厂驱动是「位带」写法 —— 直接读写 SPI 块的 IOC(0x08)/RDS(0x0c)，
#   每 bit 前后各 udelay(4)，折算 125kHz。
#   而 AR934x 的硬件 SPI 引擎（spi-ar934x）分频寄存器只有 6 位（GENMASK(5,0)），
#   最快的分频比也就 1/128 -> 1.5625MHz，setup() 还会直接拒掉更低的速率
#   （dmesg: "spi clock is too low"）。
#   所以想复刻原厂时序，只能拿回 MMIO：打开 CONFIG_DEVMEM，用户态 mmap 0x1f000000。
#
# 只打开这一项是不够的，还有两个坑（都在 workflow 里处理，见 build-openwrt.yml）：
#
#   坑 1  OpenWrt 的 target/linux/generic/config-6.12 里显式写着
#         "# CONFIG_DEVMEM is not set"，必须先翻成 =y。
#         本文件追加到 target 层只是双保险（合并时 target 覆盖 generic）。
#
#   坑 2  CONFIG_IO_STRICT_DEVMEM=y 会让 /dev/mem 拒绝访问任何已被
#         request_mem_region 登记的 I/O 区域。而 0x1f000000 正被
#         spi@1f000000 占着 —— 不关掉这一项，DEVMEM 开了也 mmap 不到。
#         （之前 carambola2-diag.bin 用 iomem=relaxed 绕的就是这件事）
#
# 注意：OpenWrt 的 kconfig 合并脚本只认 "CONFIG_X=y" 这种行，
# 写 "# CONFIG_X is not set" 不会生效（那一行只对 read_config 有意义，
# 所以 sed 出来的 not-set 行仍然是有效的 —— 它被解析成 n）。

CONFIG_DEVMEM=y

# ---------------------------------------------------------------------------
# I2C + WM8988 依赖链（run 42762637082 教训）
#
# 现象：kmod-sound-soc-ath79 打包报
#   ERROR: module '.../sound/soc/codecs/snd-soc-wm8988.ko' is missing.
#
# 根因：ath79 的 target/linux/ath79/config-6.12 里完全没有 I2C/SND 行
#   （CONFIG_I2C 未启用），而 sound/soc/codecs/Kconfig 的 WM8988
#   depends on I2C。kmod 元数据的 KCONFIG 合并走 olddefconfig 时，
#   依赖不满足的符号被静默降为 n —— WM8988 永远编不出来。
#   虽然 buildroot.config 选了 kmod-i2c-gpio（理论会带出 I2C=m），
#   但 kconfig 合并顺序的坑和 DEVMEM（坑 3）同类：靠隐式传递不可靠。
#
# 对策：把整条依赖链显式写进内核基础配置（本文件被 workflow 追加到
#   generic/target/subtarget 末尾，后行必胜）。
#
# 注意：必须 =m 不能 =y —— kmod 包的 FILES 期待 .ko 文件，
#   若写 =y 内置进内核，kmod-i2c-core/gpio 打包时会反向报 module missing。
# ---------------------------------------------------------------------------
CONFIG_I2C=m
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_ALGOBIT=m
CONFIG_I2C_GPIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_WM8988=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SIMPLE_CARD_UTILS=m

# (2026-11-10) 此文件必须 LF：push_api 直传工作区字节，CRLF 会破坏内核配置自检

# 坑 4（run 42770592532）：WM8988 的真实依赖不是 I2C，而是
#   SND_SOC_I2C_AND_SPI（promptless tristate，默认随 I2C/SPI 推导）。
#   理论上 I2C=m 时它应为 m，但事实是 wm8988.ko 依旧缺失 ——
#   显式钉住这个符号，同时失败诊断段会输出四层配置文件的真实值。
CONFIG_SND_SOC_I2C_AND_SPI=m
