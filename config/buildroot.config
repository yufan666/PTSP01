# PTSP01 buildroot 基线配置
# 只选一个设备，最大限度压缩编译时间

CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_8dev_carambola2=y
CONFIG_TARGET_MULTI_PROFILE=n

# 增量编译靠 ccache，第二次跑能省一大半时间
CONFIG_CCACHE=y

CONFIG_DEVEL=n
CONFIG_SIGNED_PACKAGES=n

# 额外产物：initramfs（uImage），可以直接丢进 breed 用 `boot mem` 试跑，不写 flash
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# PL7223 相关：PCA9554A 挂在 GPIO 模拟 I2C 上
CONFIG_PACKAGE_kmod-i2c-gpio=y
CONFIG_PACKAGE_kmod-gpio-pca953x=y
CONFIG_PACKAGE_i2c-tools=y

# 用户态 SPI 出口（备用：硬件引擎 1.5625MHz 那条路）
CONFIG_PACKAGE_kmod-spi-dev=y

# MQTT 客户端（ptsp01-mqtt.sh 守护用，Home Assistant 自动发现接入）
# 来自自己 fork 的 packages feed，nossl 版体积小（家用 LAN 无需 TLS）
CONFIG_PACKAGE_mosquitto-client-nossl=y

# ===== USB 主机（2026-11-10）=====
# AR9331 USB：DTS 里 usb@1b000000 是 "chipidea,usb2"、dr_mode=host
#   → chipidea 通用驱动 + ci_hdrc_usb2（usb2 变体）两个包都要
# 硬件实测（2026-11-08 原厂内核）：数据线完好，U盘(HS)/CH340(FS) 正常枚举；
#   随身WiFi 直插因高速 chirp 瞬态电流拉垮口电压而失败，必须有源 USB HUB
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-chipidea=y
CONFIG_PACKAGE_kmod-usb-chipidea2=y
# USB 上网（随身WiFi / USB 网卡）：覆盖 RNDIS / CDC-ECM / NCM / 华为 / QMI / 常见网卡
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
# USB 串口（CH340 调试线 / PL2303 / FTDI / CP210x / CDC-ACM）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-acm=y
# USB 存储（U盘/移动硬盘）+ 常见文件系统
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
# lsusb 等调试工具
CONFIG_PACKAGE_usbutils=y

# 音频（2026-11-10）：AR9331 I2S -> WM8988 -> 3.5mm 耳机孔
# kmod-sound-soc-ath79 是我们 fork 的 sound.mk 新增包（含 ath79 驱动 + wm8988 + simple-card）
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_kmod-sound-soc-core=y
CONFIG_PACKAGE_kmod-sound-soc-ath79=y
CONFIG_PACKAGE_alsa-utils=y
