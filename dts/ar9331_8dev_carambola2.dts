// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// PTSP01 插排（邦讯玩儿插排）设备树
// 硬件基线：8devices Carambola 2（AR9331 / 64MB DRAM / W25Q128 16MB）
//
// 相对上游 target/linux/ath79/dts/ar9331_8dev_carambola2.dts 的改动，
// 每处均以 [PTSP01] 标注，来源都是 2026-11-08 对原厂 3.3.8 固件的实测：
//
//   1. ref 晶振 40MHz -> 25MHz
//      原厂内核 log: AR9331 ref = 25MHz；不改会导致 UART 波特率 / SPI 时钟 / DDR 时序全偏
//   2. 删除 /keys（WPS 键）
//      它占 GPIO11，而 GPIO11 = PCA9554A 的 I2C SCL
//   3. 删除 /leds/eth0、/leds/eth1
//      分别占 GPIO13 / GPIO14，而 GPIO14 = PL7223 的 RST
//   4. 新增 /i2c-gpio + PCA9554A(0x38)
//      PL7223 的隔离使能、片选都挂在这颗扩展器上（原厂 ko 依赖 i2c_master_send/recv）
//   5. &spi 下新增 spidev@1
//      给 PL7223 留一个用户态出口；CS0 仍然归 spi-nor（flash）

#include "ar9331.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "8devices Carambola2";
	compatible = "8dev,carambola2", "qca,ar9331";

	aliases {
		label-mac-device = &wmac;
	};

	leds {
		compatible = "gpio-leds";

		wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		/* [PTSP01] 上游这里的 eth0(GPIO13) / eth1(GPIO14) 已删除 */
	};

	/* [PTSP01] 上游的 /keys（wps@GPIO11）已删除 */

	/*
	 * [PTSP01] GPIO 模拟 I2C —— 接 PCA9554A
	 *
	 * 极性依据（原厂寄存器实测）：
	 *   SDA(GPIO17)：OUT.bit17 恒 0 + 翻转 OE，空闲高靠板上 10k 上拉
	 *                => 必须走「开漏模拟」，因此 **不能** 声明 i2c-gpio,sda-open-drain
	 *                   （该属性在 i2c-gpio 驱动里语义反转：声明了反而变推挽）
	 *   SCL(GPIO11)：OE.bit11 恒 1 推挽，板上无上拉
	 *                => 声明 i2c-gpio,scl-has-no-pullup
	 *
	 * pinctrl-0 是必须的：0x28 的 bit3~7 是 ETH_SWITCH_LED0..4_EN，
	 * 一旦为 1，GPIO17 的输出锁存立刻失效、被交换机 LED 输出接管，SDA 永远拉不低。
	 * breed / U-Boot 在不同次上电后该位并不稳定，所以必须在内核里清掉。
	 */
	i2c_gpio: i2c-gpio {
		compatible = "i2c-gpio";
		status = "okay";

		sda-gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
		scl-gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
		i2c-gpio,scl-has-no-pullup;
		i2c-gpio,delay-us = <5>;

		pinctrl-names = "default";
		pinctrl-0 = <&switch_led_disable_pins>;

		#address-cells = <1>;
		#size-cells = <0>;

		pca9554: gpio@38 {
			compatible = "nxp,pca9554";
			reg = <0x38>;
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

&ref {
	/* [PTSP01] 本板晶振 25MHz（carambola2 官方设计是 40MHz） */
	clock-frequency = <25000000>;
};

&usb {
	dr_mode = "host";
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&spi {
	/*
	 * [PTSP01] 强制绑定位带驱动。
	 * OpenWrt 的 ath79.dtsi 把这个节点声明成 "qca,ar934x-spi"（硬件引擎），
	 * 实测（2026-11-09，initramfs c12fa92）它接管后：
	 *   spi spi0.1: spi clock is too low        <- 125kHz 被拒（分频 6 位，最低 1.5625MHz）
	 *   spi-ar934x 1f000000.spi: cs3 >= max 3   <- 不解析 cs-gpios，num_chipselect 恒 3
	 * 三个 PL7223 孔全部注册失败。
	 * 改成 "qca,ar7100-spi" 绑回 spi-ath79（spi_bitbang 位带实现）：
	 *   - use_gpio_descriptors=true，cs-gpios 生效，num_chipselect 抬到 4；
	 *   - cs->nsecs=(1e9/2)/hz，125kHz = 半位 4000ns，正好复刻原厂 udelay(4)；
	 *   - flash 走同一个驱动（AR71xx 时代所有 ath79 设备都是它带的 flash，
	 *     mem_ops 快读只对原生 CS0 生效，本板 flash 正是 CS0）。
	 */
	compatible = "qca,ar7100-spi";

	status = "okay";

	/*
	 * [PTSP01] PL7223 的片选：全部走 cs-gpios，
	 * SPI 核心用 gpiod 拉片选，控制器只负责 CLK/MOSI/MISO 的位带。
	 * 这是原厂 flash_spi_down 那套的现代等价物，时序由内核保证。
	 *
	 * 为什么不用 /dev/mem 自己做位带（2026-11-09 实测）：
	 *   从用户态经 /dev/mem 写 SPI 控制器 IOC 寄存器（0x1f000008）无效
	 *   —— 写 0x12345678 回读仍是 0x70000，GPIO IN 也不跟随。
	 *   而内核 spi-ath79 本身就是位带驱动（spi_bitbang + 手写 IOC），
	 *   jedec_id 能读回 ef4018，证明内核侧写 IOC 完全正常。
	 *   => 位带只能由内核做。
	 *
	 * ⚠ spi-ath79 置了 SPI_CONTROLLER_GPIO_SS，spi_set_cs() 会在拨完
	 *   cs-gpios 之后**再调一次控制器的 chipselect**，即写 IOC bit(16+reg)。
	 *   IOC bit17 = 硬件 CS1 引脚 = GPIO17 = 本板 I²C SDA，
	 *   IOC bit18 = GPIO18。所以「走扩展器」的那个孔特意安排到 reg=3
	 *   （IOC bit19，无对应引脚，绝对无害）。
	 *
	 * cs-gpios 索引 = spi 设备的 reg：
	 *   [0] <0>          -> flash 仍用控制器原生 CS0（官方 binding 里
	 *                       "<0>" 就是「本项用原生片选」的写法）
	 *   [1] GPIO26       -> PL7223 孔3 片选（原厂 CS3=26）
	 *   [2] GPIO1        -> PL7223 孔2 片选（原厂 CS2=1）
	 *   [3] <0>          -> PL7223 孔1：交给控制器原生 CS3
	 *                       = IOC bit19，本板无对应引脚，绝对无害。
	 *                       孔1 真正的片选是 GPIO17，由 pl7223.sh 用
	 *                       /dev/mem 位带（OE bit17）手动控制。
	 *
	 * 为什么孔1 必须用 <0> 而不是扩展器 P1（2026-11-10 真机实测）：
	 *   原 DTS 把孔1 片选挂到 PCA9554 的 P1。但内核每次对该设备做 SPI
	 *   事务都要经 i2c 写 P1，而孔1 的片选 GPIO17 **正是 i2c 的 SDA**
	 *   —— GPIO17 一拉低，i2c 立刻死，内核 gpiod 操作超时，连带把 PCA
	 *   的 P0（SPI 隔离使能）一起带掉，于是三孔全部读回 00。
	 *   实测对照：不碰孔1 时孔2/孔3 读写完全正常（写 0x20 读回 0x20）；
	 *   一旦插入孔1 事务，三孔全 0。改成 <0> 后内核不再碰 i2c。
	 *
	 * 注意：cs-gpios / num-cs 必须写在所有子节点之前 ——
	 * dtc 只允许属性先于子节点，否则报
	 * "Properties must precede subnodes"（曾因此让整个构建挂在 install 阶段）。
	 */
	cs-gpios = <0>, <&gpio 26 GPIO_ACTIVE_LOW>,
		   <&gpio 1 GPIO_ACTIVE_LOW>, <0>;
	num-cs = <4>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			uboot: partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
				read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xfa0000>;
			};

			partition@ff0000 {
				label = "art";
				reg = <0xff0000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * [PTSP01] 注意：本板 ART 是 AP121F 布局，真实 MAC 在 +0x1002，
					 * 不是上游假设的 +0x0。上游 <0x0 0x6> 在本机会读到 FF:FF:FF:FF:FF:FF。
					 *
					 * 这里暂不改 nvmem 偏移 —— 因为 MAC 夹在 calibration(0x1000+0x440)
					 * 内部，改偏移会造成 nvmem cell 重叠。MAC 改由
					 * files/etc/uci-defaults/99-ptsp01-mac 在首次启动时写死。
					 */
					macaddr_art_0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					macaddr_art_6: macaddr@6 {
						reg = <0x6 0x6>;
					};

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};
				};
			};
		};
	};

	/*
	 * 125kHz = 原厂位带速率（每个半位 4us），
	 * spi_bitbang 会按 max_speed_hz 用 ndelay 精确控制。
	 */
	spidev@1 {				/* -> PL7223 孔3 (CS = GPIO26) */
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <125000>;
	};

	spidev@2 {				/* -> PL7223 孔2 (CS = GPIO1) */
		compatible = "rohm,dh2228fv";
		reg = <2>;
		spi-max-frequency = <125000>;
	};

	spidev@3 {				/* -> PL7223 孔1 (CS = GPIO17，手动位带；本项用原生 CS3 空引脚) */
		compatible = "rohm,dh2228fv";
		reg = <3>;
		spi-max-frequency = <125000>;
	};
};

&mdio0 {
	status = "okay";
};

&eth0 {
	status = "okay";

	nvmem-cells = <&macaddr_art_0>;
	nvmem-cell-names = "mac-address";

	gmac-config {
		device = <&gmac>;

		switch-phy-addr-swap = <1>;
		switch-phy-swap = <1>;
	};
};

&eth1 {
	status = "okay";

	nvmem-cells = <&macaddr_art_6>;
	nvmem-cell-names = "mac-address";
};

&wmac {
	status = "okay";

	nvmem-cells = <&macaddr_art_6>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};
